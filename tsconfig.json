{
  "compilerOptions": {
    "target": "es2023",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2023"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "types": ["node"],
    "verbatimModuleSyntax": false,
    "isolatedModules": true,
    "noUnusedLocals": false,
    "esModuleInterop": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "spikes/**/*.ts", "vitest.config.ts"]
}
