{
  "name": "dsh-verifier-mode",
  "version": "0.0.0",
  "private": true,
  "description": "P0 spikes for a DeepSeek Harness verifier-mode plugin. Not the MVP.",
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client/index.ts"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.5-alpha.1 <5",
    "@deepseek-ai/schemastery": ">=3.18.5-alpha.1 <4",
    "@deepseek-ai/dsh-agent": ">=0.2.1-alpha.1 <0.3.0",
    "@deepseek-ai/dsh-agent-loop": ">=0.2.1-alpha.1 <0.3.0",
    "@deepseek-ai/dsh-api-session-controller": ">=0.2.1-alpha.1 <0.3.0",
    "@deepseek-ai/dsh-client-connection": ">=0.2.1-alpha.1 <0.3.0",
    "@deepseek-ai/dsh-client-locale": ">=0.2.1-alpha.1 <0.3.0",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.2.1-alpha.1 <0.3.0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.2.1-alpha.1 <0.3.0",
    "@deepseek-ai/dsh-commands": ">=0.2.1-alpha.1 <0.3.0",
    "@deepseek-ai/dsh-headless": ">=0.2.1-alpha.1 <0.3.0",
    "@deepseek-ai/dsh-llm": ">=0.2.1-alpha.1 <0.3.0",
    "@deepseek-ai/dsh-plan-mode": ">=0.2.1-alpha.1 <0.3.0",
    "@deepseek-ai/dsh-session": ">=0.2.1-alpha.1 <0.3.0",
    "@deepseek-ai/dsh-session-projection": ">=0.2.1-alpha.1 <0.3.0",
    "@deepseek-ai/dsh-storage": ">=0.2.1-alpha.1 <0.3.0",
    "@deepseek-ai/dsh-storage-domain": ">=0.2.1-alpha.1 <0.3.0",
    "@deepseek-ai/dsh-storage-json": ">=0.2.1-alpha.1 <0.3.0",
    "@deepseek-ai/dsh-system-prompt": ">=0.2.1-alpha.1 <0.3.0",
    "@deepseek-ai/dsh-tools": ">=0.2.1-alpha.1 <0.3.0",
    "@deepseek-ai/dsh-user-questions": ">=0.2.1-alpha.1 <0.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "typescript": "^5.9.2",
    "vite-tsconfig-paths": "^6.0.3",
    "vitest": "^3.2.4",
    "zod": "4.4.3"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest"
  }
}
