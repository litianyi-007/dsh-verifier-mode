{
  "name": "dsh-verifier-mode",
  "version": "0.0.0",
  "private": true,
  "description": "DeepSeek Harness verifier-mode plugin. P1 covers session switch, D1, D4, plan-mode advice, and a per-model CNY cap. The TypeSafe key is set from the Plugins page and stored as a credential.",
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.4 || >=4.0.5-alpha.1 <5",
    "@deepseek-ai/schemastery": "3.18.4 || >=3.18.5-alpha.1 <4",
    "@deepseek-ai/dsh-agent": "^0.2.0-rc.2 || ^0.2.1-alpha.1",
    "@deepseek-ai/dsh-agent-loop": "^0.2.0-rc.2 || ^0.2.1-alpha.1",
    "@deepseek-ai/dsh-api-session-controller": "^0.2.0-rc.2 || ^0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-connection": "^0.2.0-rc.2 || ^0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-locale": "^0.2.0-rc.2 || ^0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.2.0-rc.2 || ^0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-ui-slots": "^0.2.0-rc.2 || ^0.2.1-alpha.1",
    "@deepseek-ai/dsh-commands": "^0.2.0-rc.2 || ^0.2.1-alpha.1",
    "@deepseek-ai/dsh-credentials": "^0.2.0-rc.2 || ^0.2.1-alpha.1",
    "@deepseek-ai/dsh-headless": "^0.2.0-rc.2 || ^0.2.1-alpha.1",
    "@deepseek-ai/dsh-llm": "^0.2.0-rc.2 || ^0.2.1-alpha.1",
    "@deepseek-ai/dsh-plan-mode": "^0.2.0-rc.2 || ^0.2.1-alpha.1",
    "@deepseek-ai/dsh-session": "^0.2.0-rc.2 || ^0.2.1-alpha.1",
    "@deepseek-ai/dsh-session-projection": "^0.2.0-rc.2 || ^0.2.1-alpha.1",
    "@deepseek-ai/dsh-storage": "^0.2.0-rc.2 || ^0.2.1-alpha.1",
    "@deepseek-ai/dsh-storage-domain": "^0.2.0-rc.2 || ^0.2.1-alpha.1",
    "@deepseek-ai/dsh-storage-json": "^0.2.0-rc.2 || ^0.2.1-alpha.1",
    "@deepseek-ai/dsh-system-prompt": "^0.2.0-rc.2 || ^0.2.1-alpha.1",
    "@deepseek-ai/dsh-tools": "^0.2.0-rc.2 || ^0.2.1-alpha.1",
    "@deepseek-ai/dsh-user-questions": "^0.2.0-rc.2 || ^0.2.1-alpha.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@deepseek-ai/cosmokit": "1.8.5",
    "@types/node": "^22.19.0",
    "@types/react": "~18.3.1",
    "esbuild": "^0.25.10",
    "react": "^18.2.0",
    "typescript": "^5.9.2",
    "vite-tsconfig-paths": "^6.0.3",
    "vitest": "^3.2.4",
    "zod": "4.4.3"
  },
  "scripts": {
    "build": "node build.mjs",
    "prepare": "node build.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  }
}
